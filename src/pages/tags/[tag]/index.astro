---
import { getCollection } from 'astro:content';
import { getAllTags, isVisible, sortByDateDesc, toPostSummary } from '../../../lib/content/posts';
import { buildSiteMeta } from '../../../lib/theme/site-meta';
import { tagHref } from '../../../lib/urls';
import TagIndex from '../../../themes/default/layouts/TagIndex.astro';
import strings from '../../../themes/default/strings';

export async function getStaticPaths() {
  const posts = (await getCollection('posts')).filter(isVisible);
  return getAllTags(posts).map((tag) => ({ params: { tag } }));
}

const { tag } = Astro.params;

const allPosts = await getCollection('posts');
const allPages = await getCollection('pages');
const posts = sortByDateDesc(
  allPosts.filter((post) => isVisible(post) && post.data.tags.includes(tag)),
).map(toPostSummary);

const site = buildSiteMeta(allPages, strings, tagHref(tag));
---

<TagIndex site={site} strings={strings} tag={tag} posts={posts} />
