---
import type { PostSummary, SiteMeta, UIStrings } from '../../../lib/theme/contract';
import PostCard from '../components/PostCard.astro';
import BaseLayout from './BaseLayout.astro';

interface Props {
  site: SiteMeta;
  strings: UIStrings;
  tag: string;
  posts: PostSummary[];
  canonicalUrl: string;
}

const { site, strings, tag, posts, canonicalUrl } = Astro.props;
---

<BaseLayout
  site={site}
  strings={strings}
  title={strings.tag.title(tag)}
  description={strings.tag.title(tag)}
  canonicalUrl={canonicalUrl}
>
  <h1>{strings.tag.title(tag)}</h1>
  {posts.length > 0 ? (
    <ul class="post-list">
      {posts.map((post) => (
        <PostCard post={post} site={site} strings={strings} />
      ))}
    </ul>
  ) : (
    <p class="empty-state">{strings.common.noPostsYet}</p>
  )}
</BaseLayout>
