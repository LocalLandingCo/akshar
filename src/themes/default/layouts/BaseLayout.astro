---
import SEOHead from '../../../lib/seo/SEOHead.astro';
import type { SiteMeta, UIStrings } from '../../../lib/theme/contract';
import { loadPresetCss } from '../../../lib/theme/presets';
import siteConfig from '../../../../site.config';
import '../base.css';

interface ShareImage {
  url: string;
  alt: string;
}

interface Props {
  site: SiteMeta;
  strings: UIStrings;
  title: string;
  description: string;
  canonicalUrl?: string;
  type?: 'website' | 'article';
  image?: ShareImage;
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
}

const { site, strings, title, description, canonicalUrl, type, image, jsonLd, noindex } =
  Astro.props;

// Preset = the personality (spec.md §7) — chosen in site.config.ts, loaded
// at build time, never a runtime request. Individual token overrides on
// top of it come from the same file and win by CSS source order.
const presetCss = loadPresetCss(siteConfig.theme.preset);
const tokenOverrideEntries = Object.entries(siteConfig.theme.tokens);
const tokenOverrideCss = tokenOverrideEntries.length
  ? `:root {\n${tokenOverrideEntries.map(([key, value]) => `  --${key}: ${value};`).join('\n')}\n}`
  : '';
---

<html lang={site.language} dir={site.dir}>
  <head>
    <style is:global set:html={presetCss}></style>
    {tokenOverrideCss && <style is:global set:html={tokenOverrideCss}></style>}
    <SEOHead
      title={title}
      siteTitle={site.title}
      description={description}
      canonicalUrl={canonicalUrl}
      type={type}
      image={image}
      rssHref={site.rssHref}
      jsonLd={jsonLd}
      noindex={noindex}
    />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#content">
      {strings.nav.skipToContent}
    </a>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="site-title" href={site.nav[0]?.href ?? '/'}>
          {site.title}
        </a>
        <nav class="site-nav" aria-label={strings.nav.homeLabel}>
          {site.nav.map((item) => (
            <a href={item.href} aria-current={item.current ? 'page' : undefined}>
              {item.label}
            </a>
          ))}
        </nav>
      </div>
    </header>
    <main id="content">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="site-footer__inner">
        <span>
          © {new Date().getFullYear()} {site.author.name}
        </span>
        <span>
          {site.rssHref && <a href={site.rssHref}>{strings.footer.rssLabel}</a>}
          {' · '}
          {strings.footer.builtWith}
        </span>
      </div>
    </footer>
  </body>
</html>
