---
import type { PostSummary, SiteMeta, UIStrings } from '../../../lib/theme/contract';
import PostCard from '../components/PostCard.astro';
import BaseLayout from './BaseLayout.astro';

interface Props {
  site: SiteMeta;
  strings: UIStrings;
  posts: PostSummary[];
}

const { site, strings, posts } = Astro.props;
---

<BaseLayout site={site} strings={strings} title={site.title} description={site.description}>
  {site.tagline && (
    <p class="empty-state" style="margin-bottom: var(--space-5);">
      {site.tagline}
    </p>
  )}
  {posts.length > 0 ? (
    <ul class="post-list">
      {posts.map((post) => (
        <PostCard post={post} site={site} strings={strings} />
      ))}
    </ul>
  ) : (
    <p class="empty-state">{strings.common.noPostsYet}</p>
  )}
</BaseLayout>
