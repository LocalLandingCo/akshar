---
// Core-owned <head> content (spec.md §7: "the core owns... what goes in
// <head>"). A theme's BaseLayout includes this rather than hand-writing SEO
// tags itself — the theme cannot get an OG tag or a canonical URL wrong
// because it never constructs one (spec.md §9's requirements, made
// structural rather than a convention every theme must remember).

interface ShareImage {
  url: string;
  alt: string;
}

interface Props {
  title: string;
  siteTitle: string;
  description: string;
  /** Omitted only for pages with no single canonical location — e.g. the catch-all 404. */
  canonicalUrl?: string;
  type?: 'website' | 'article';
  image?: ShareImage;
  rssHref?: string;
  rssTitle?: string;
  jsonLd?: Record<string, unknown>[];
  /** Search, the 404 page — anything that shouldn't be indexed. */
  noindex?: boolean;
}

const {
  title,
  siteTitle,
  description,
  canonicalUrl,
  type = 'website',
  image,
  rssHref,
  rssTitle,
  jsonLd = [],
  noindex = false,
} = Astro.props;

const pageTitle = title === siteTitle ? title : `${title} · ${siteTitle}`;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{pageTitle}</title>
<meta name="description" content={description} />
{canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
{noindex && <meta name="robots" content="noindex" />}
{rssHref && (
  <link rel="alternate" type="application/rss+xml" title={rssTitle ?? siteTitle} href={rssHref} />
)}

<meta property="og:type" content={type} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
{canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
<meta property="og:site_name" content={siteTitle} />
{image && <meta property="og:image" content={image.url} />}
{image && <meta property="og:image:alt" content={image.alt} />}

<meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
{image && <meta name="twitter:image" content={image.url} />}

{jsonLd.map((data) => (
  <script type="application/ld+json" is:inline set:html={JSON.stringify(data)}></script>
))}
